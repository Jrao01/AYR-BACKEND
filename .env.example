# ── Servidor ─────────────────────────────────────────────
NODE_ENV=development
PORT=2000
# Nº de saltos de proxy inverso (0 = sin proxy; 1 = Traefik/Nginx;
# 2 = Cloudflare + Traefik). Si se deja en 0 detrás de un proxy, todos los
# clientes comparten la IP del proxy y los límites por IP son globales.
TRUST_PROXY=0
LOG_LEVEL=info

# ── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ayr?schema=public

# ── Autenticación (genera valores propios: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=cambia-este-access-secret
JWT_REFRESH_SECRET=cambia-este-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE=ayr_rt
# Intentos de login por ventana (por IP)
AUTH_RATE_MAX=10
GLOBAL_RATE_MAX=300
AUTH_RATE_WINDOW_MS=900000

# ── CORS (orígenes permitidos, separados por coma) ───────
# Obligatoria en producción (el proceso no arranca sin un origen válido).
# Se normaliza: se quita la barra final y se añade https:// si falta el esquema.
# Incluye www explícitamente si el sitio se abre también desde ahí.
# Producción: CORS_ORIGINS=https://ayrnetworxv.ve,https://www.ayrnetworxv.ve
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Imágenes ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Documentos privados de las solicitudes (cédula y comprobante de domicilio).
# No se sirven desde /uploads; solo por el endpoint autenticado del panel.
CONTACT_UPLOAD_DIR=./contact-uploads

# ── Usuario administrador inicial (solo lo crea si no existe) ──
ADMIN_EMAIL=admin@ayrnetworxv.ve
ADMIN_PASSWORD=admin123*
# Sembrado automático al arrancar: crea el admin si no hay usuarios y
# ejecuta el seed si falta cualquiera de las tablas base. true/false.
AUTO_SEED=true

# ── Correo (Resend) ───────────────────────────────────────
# API key de Resend con permiso de envío (https://resend.com/api-keys).
# El dominio remitente (ayrnetworxv.ve) debe estar verificado en Resend.
RESEND_API_KEY=re_tu_api_key_aqui

# Wisphub: registro de solicitudes de preinstalación
# Sandbox: https://sandbox-api.wisphub.net/api/solicitar-instalacion/
# Producción: https://api.wisphub.net/api/solicitar-instalacion/
WISPHUB_API_URL=https://api.wisphub.net/api/solicitar-instalacion/
WISPHUB_API_KEY=
